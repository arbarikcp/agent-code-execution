# Copy to .env (gitignored) and fill in real values. Never commit .env or keys.txt.

# Required from Chapter 5 onward — the backbone agent's model provider.
# litellm resolves this automatically for a "groq/..." BACKBONE_MODEL.
GROQ_API_KEY=

# Optional: override the default model (groq/llama-3.3-70b-versatile).
# Any litellm-supported model string works, e.g. "anthropic/claude-...".
# BACKBONE_MODEL=groq/llama-3.3-70b-versatile
